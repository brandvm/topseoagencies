---
import Page from '../layouts/Page.astro';import Feature from '../components/Feature.astro';import GuideCard from '../components/GuideCard.astro';import Cover from '../components/Cover.astro';import Icon from '../components/Icon.astro';import AgencyIndex from '../components/AgencyIndex.astro';import Approach from '../components/Approach.astro';
import site from '../data/site.json';import {articles,href,withBase} from '../lib/content';
const posts=await articles();const featured=posts[0];
---
<Page>
<section class="hero research-hero" data-review-anchor="hero"><div><p class="eyebrow">Search expertise, in focus</p><h1>Find the expertise.<br><em>See the opportunity.</em></h1><p class="intro">A clearer view of the SEO agency landscape. Compare capabilities, budgets, and approaches before you build your shortlist.</p><div class="actions"><a class="button" href={withBase("/blog/")}>Explore the guides <Icon name="arrow-up-right"/></a><a class="text-link" href="#our-approach">Our approach</a></div></div>{featured&&<article class="research-dossier" data-review-anchor="featured-guide"><Cover eager/><div class="dossier-copy"><p class="eyebrow">Research dossier / 2026</p><h2>{featured.data.title}</h2><a class="text-link" href={href(featured.data.slug)}>Open the agency guide <Icon name="arrow-up-right"/></a></div></article>}</section><div class="research-meta"><div><strong>10</strong><span>Agencies compared</span></div><div><strong>10</strong><span>Questions answered</span></div><div><Icon name="list-bullets"/><span>Methodology included</span></div></div><section class="section" data-review-anchor="agency-shortlist"><div class="index-head"><div><p class="eyebrow">Inside the guide</p><h2>Start your shortlist.</h2></div></div>{featured&&<AgencyIndex slug={featured.data.slug}/>}<p class="small" style="margin-top:20px">The first three agencies in the guide. Read the full comparison for rankings, qualifications, and methodology.</p></section><section class="section" data-review-anchor="guides"><Feature post={featured}/></section><Approach/></Page>
